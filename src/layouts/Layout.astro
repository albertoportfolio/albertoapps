---
// Root layout: SEO metadata (title/description, OpenGraph, Twitter, robots,
// canonical), self-hosted Inter font (@fontsource), and JSON-LD (ProfessionalService).
// The canonical domain lives in the SITE_URL constant (keep it in sync with
// `site` in astro.config.mjs and public/robots.txt).
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import "../styles/globals.css";
import { site } from "../data/site";

// Preload of the above-the-fold Latin woff2 files: without this the browser
// won't request the fonts until it parses the CSS, and the text repaints once
// Inter arrives (it looks like the page loads twice). All four imported
// weights are used above-the-fold, so all of them are preloaded.
import inter400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import inter600 from "@fontsource/inter/files/inter-latin-600-normal.woff2?url";
import inter700 from "@fontsource/inter/files/inter-latin-700-normal.woff2?url";
import inter800 from "@fontsource/inter/files/inter-latin-800-normal.woff2?url";

const PRELOAD_FONTS = [inter400, inter600, inter700, inter800];

export const SITE_URL = "https://albertoapps.info";

const TITLE = "AlbertoApps · Custom App & Web Development.";
const DESCRIPTION =
  "Freelance developer building mobile apps in Flutter and websites with React for businesses. API development with Java and Spring. No-obligation quote.";
const OG_DESCRIPTION =
  "Flutter apps and React websites built for your business, with a Java and Spring API. Get a no-obligation quote.";
const KEYWORDS = [
  "app development",
  "mobile app developer",
  "web development",
  "freelance Flutter developer",
  "Flutter apps",
  "React web development",
  "Java Spring API",
  "iOS and Android apps",
  "custom software development",
  "app consultancy",
  "AlbertoApps",
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.brand,
  url: SITE_URL,
  image: `${SITE_URL}/aplogo.png`,
  email: site.email,
  description:
    "Mobile apps in Flutter and websites with React built for businesses, with a Java and Spring API.",
  areaServed: "ES",
  knowsAbout: [
    "Flutter",
    "Dart",
    "React",
    "TypeScript",
    "Java",
    "Spring",
    "Mobile app development",
    "Web development",
    "API development",
  ],
  sameAs: [site.github, site.linkedin, site.youtube],
  founder: {
    "@type": "Person",
    name: site.name,
    jobTitle: site.role,
    sameAs: [site.github, site.linkedin, site.youtube],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {PRELOAD_FONTS.map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta name="keywords" content={KEYWORDS.join(", ")} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={`${SITE_URL}/`} />
    <link rel="icon" href="/aplogo.png" type="image/png" />
    <link rel="apple-touch-icon" href="/aplogo.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1"
    />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={OG_DESCRIPTION} />
    <meta property="og:image" content={`${SITE_URL}/aplogo.png`} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="AlbertoApps" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={OG_DESCRIPTION} />
    <meta name="twitter:image" content={`${SITE_URL}/aplogo.png`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Marks that JS is present: scroll reveals (.reveal) are only hidden under
         html.js, so content always stays visible without JavaScript. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  // Scroll reveals: replaces framer-motion (whileInView + once: true).
  // Each .reveal element animates only once when it enters the viewport;
  // the staggered delay is controlled with the --rd custom property.
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("in-view");
          io.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.2, rootMargin: "0px 0px -8% 0px" }
  );

  document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
</script>