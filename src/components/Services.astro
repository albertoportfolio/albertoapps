---
const services = [
  {
    icon: "📱",
    title: "Flutter Apps",
    text: "iOS and Android apps with a single codebase: fast, native, and ready to publish on the app stores.",
  },
  {
    icon: "🌐",
    title: "Custom Websites",
    text: "Landing pages and modern web apps built with React, optimized for SEO and conversion.",
  },
  {
    icon: "🎨",
    title: "UI/UX Design",
    text: "Polished interfaces, smooth animations, and a user experience designed for your audience.",
  },
  {
    icon: "⚙️",
    title: "APIs & Backend",
    text: "Robust backend systems and REST APIs built with Java and Spring, ready to power your apps at scale.",
  },
];
---

<section id="services" class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-kicker">Services</span>
      <h2 class="section-title">What can I do for you?</h2>
      <p class="section-sub">
        Custom app and web development solutions, built around your
        business needs.
      </p>
    </div>

    <div class="services-grid">
      {services.map((s, i) => (
        <article class="card reveal" style={`--rd: ${i * 0.1}s`}>
          <div class="card-icon">{s.icon}</div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>