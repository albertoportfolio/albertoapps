---
import { site } from "../data/site";

const COUNTRIES = [
  { flag: "🇪🇸", dial: "+34" },
  { flag: "🇺🇸", dial: "+1" },
  { flag: "🇬🇧", dial: "+44" },
  { flag: "🇮🇪", dial: "+353" },
  { flag: "🇫🇷", dial: "+33" },
  { flag: "🇩🇪", dial: "+49" },
  { flag: "🇵🇹", dial: "+351" },
  { flag: "🇮🇹", dial: "+39" },
  { flag: "🇳🇱", dial: "+31" },
  { flag: "🇧🇪", dial: "+32" },
  { flag: "🇨🇭", dial: "+41" },
  { flag: "🇦🇹", dial: "+43" },
  { flag: "🇸🇪", dial: "+46" },
  { flag: "🇳🇴", dial: "+47" },
  { flag: "🇩🇰", dial: "+45" },
  { flag: "🇫🇮", dial: "+358" },
  { flag: "🇵🇱", dial: "+48" },
  { flag: "🇷🇴", dial: "+40" },
  { flag: "🇬🇷", dial: "+30" },
  { flag: "🇲🇽", dial: "+52" },
  { flag: "🇦🇷", dial: "+54" },
  { flag: "🇨🇴", dial: "+57" },
  { flag: "🇨🇱", dial: "+56" },
  { flag: "🇧🇷", dial: "+55" },
  { flag: "🇵🇪", dial: "+51" },
  { flag: "🇻🇪", dial: "+58" },
  { flag: "🇦🇺", dial: "+61" },
  { flag: "🇯🇵", dial: "+81" },
];
---

<section id="contact" class="section">
  <div class="container contact-wrap">
    <div class="contact-info reveal reveal-left">
      <span class="section-kicker">Contact</span>
      <h2>Have an idea? Let's talk.</h2>
      <p>
        Tell me what app or website you need and I'll get back to you as
        soon as possible with a no-obligation proposal.
      </p>
      <div class="contact-channels">
        <a class="channel" href={`mailto:${site.email}`}>
          <span class="ico">✉️</span> {site.email}
        </a>
        <a class="channel" href={site.linkedin} target="_blank" rel="noopener noreferrer">
          <span class="ico">💼</span> LinkedIn
        </a>
        <a class="channel" href={site.github} target="_blank" rel="noopener noreferrer">
          <span class="ico">💻</span> GitHub
        </a>
      </div>
    </div>

    <form
      class="form reveal reveal-right"
      style="--rd: 0.1s"
      novalidate
      data-endpoint="/api/contact"
      data-email={site.email}
    >
      <!-- Subject and anti-spam honeypot -->
      <input type="hidden" name="subject" value="New contact from albertoapps.info" />
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

      <!-- Full phone number (prefix + number) filled by JS on submit -->
      <input type="hidden" name="phone" value="" />

      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" placeholder="Your name" autocomplete="name" />
      </div>

      <div class="field-row">
        <div class="field">
          <label for="email">
            Email <span class="req">*</span>
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            placeholder="you@email.com"
            autocomplete="email"
          />
          <span class="field-error" data-error-for="email" hidden></span>
        </div>
        <div class="field">
          <label for="phone">
            Mobile <span class="req">*</span>
          </label>
          <div class="phone-field">
            <select id="phone-prefix" class="phone-prefix" aria-label="Country code" autocomplete="tel-country-code">
              {COUNTRIES.map((c) => (
                <option value={c.dial} selected={c.dial === "+34"}>
                  {c.flag} {c.dial}
                </option>
              ))}
            </select>
            <input
              id="phone"
              type="tel"
              class="phone-number"
              placeholder="612 345 678"
              autocomplete="tel-national"
            />
          </div>
          <span class="field-error" data-error-for="phone" hidden></span>
        </div>
      </div>

      <div class="field">
        <label for="message">
          What app or website do you need? <span class="req">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          required
          placeholder="Describe your idea: type of app, features, timeline..."></textarea>
        <span class="field-error" data-error-for="message" hidden></span>
      </div>

      <button type="submit" class="btn btn-primary">Send message →</button>

      <p class="form-status" hidden></p>
    </form>
  </div>
</section>

<script>
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const WEB3FORMS_ACCESS_KEY = "412f062b-3bde-4d11-bf62-3fb2cd27a934";
  const WEB3FORMS_ENDPOINT = "https://api.web3forms.com/submit";

  const form = document.querySelector<HTMLFormElement>("#contact .form")!;
  const email = form.querySelector<HTMLInputElement>("#email")!;
  const prefix = form.querySelector<HTMLSelectElement>(".phone-prefix")!;
  const phone = form.querySelector<HTMLInputElement>("#phone")!;
  const phoneField = form.querySelector<HTMLElement>(".phone-field")!;
  const hiddenPhone = form.querySelector<HTMLInputElement>('input[name="phone"]')!;
  const message = form.querySelector<HTMLTextAreaElement>("#message")!;
  const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const status = form.querySelector<HTMLParagraphElement>(".form-status")!;

  const setError = (name: string, control: HTMLElement, text: string | null) => {
    const span = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`)!;
    span.hidden = !text;
    span.textContent = text ?? "";
    const target = name === "phone" ? phoneField : control;
    target.classList.toggle("invalid", !!text);
    control.setAttribute("aria-invalid", String(!!text));
  };

  const validate = () => {
    let ok = true;
    const emailVal = email.value.trim();
    const phoneVal = phone.value.trim();
    const messageVal = message.value.trim();

    if (!emailVal) {
      setError("email", email, "Email is required.");
      ok = false;
    } else if (!EMAIL_RE.test(emailVal)) {
      setError("email", email, "Please enter a valid email.");
      ok = false;
    } else setError("email", email, null);

    if (!phoneVal) {
      setError("phone", phone, "Mobile number is required.");
      ok = false;
    } else if (phoneVal.replace(/\D/g, "").length < 6) {
      setError("phone", phone, "Please enter a valid number.");
      ok = false;
    } else setError("phone", phone, null);

    if (!messageVal) {
      setError("message", message, "Tell me what app or website you need.");
      ok = false;
    } else setError("message", message, null);

    return ok;
  };

  const showStatus = (kind: "ok" | "error", text: string) => {
    status.hidden = false;
    status.className = `form-status ${kind}`;
    status.textContent = text;
  };

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!validate()) return;

    hiddenPhone.value = `${prefix.value} ${phone.value.trim()}`.trim();
    submitBtn.disabled = true;
    submitBtn.textContent = "Sending...";
    status.hidden = true;

    try {
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      const res = await fetch(WEB3FORMS_ENDPOINT, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json",
        },
        body: JSON.stringify({
          ...data,
          access_key: WEB3FORMS_ACCESS_KEY,
        }),
      });

      const result = await res.json();

      if (result.success) {
        showStatus("ok", "✅ Message sent! I'll get back to you soon.");
        form.reset();
      } else {
        throw new Error(result.message || "Error sending message");
      }
    } catch {
      showStatus(
        "error",
        `❌ Couldn't send the message. Please email me directly at ${form.dataset.email}.`
      );
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Send message →";
    }
  });
</script>