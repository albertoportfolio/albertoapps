---
import { site } from "../data/site";
import Iphone from "./magicui/Iphone.astro";

const stats = [
  { value: "Flutter", label: "iOS & Android Apps" },
  { value: "React", label: "Websites · TypeScript" },
  { value: "Java", label: "API with Spring" },
];
---

<section id="home" class="hero">
  <div class="hero-blob hero-blob-1"></div>
  <div class="hero-blob hero-blob-2"></div>

  <div class="container hero-grid">
    <div class="hero-content">
      <span class="hero-badge">Available for new projects</span>

      <h1>
        {site.tagline.split(" ").slice(0, 2).join(" ")}{" "}
        <span class="grad">{site.tagline.split(" ").slice(2).join(" ")}</span>
      </h1>

      <p>
        I build <strong>mobile apps</strong> and{" "}
        <strong>websites</strong> tailored to your business. Careful design, solid performance, and professional
        delivery, from idea to production.
      </p>

      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary">Tell me your idea →</a>
        <a href="#projects" class="btn btn-ghost">View projects</a>
      </div>

      <div class="hero-stats">
        {stats.map((s) => (
          <div class="hero-stat">
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-phone">
        <Iphone>
          <div class="phone-screen">
            <div class="ps-statusbar">
              <span>9:41</span>
              <span class="ps-statusbar-icons">
                <i></i>
                <i></i>
                <i class="ps-battery"></i>
              </span>
            </div>

            <div class="ps-header">
              <div>
                <span class="ps-hello">Hi, Alex</span>
                <strong class="ps-title">ProjectHub</strong>
              </div>
              <span class="ps-avatar">A</span>
            </div>

            <span class="ps-section">Overview</span>
            <div class="ps-grid">
              <div class="ps-tile ps-tile-wide ps-tile-accent">
                <span class="ps-tile-label">Active projects</span>
                <strong class="ps-tile-value">12</strong>
                <span class="ps-tile-sub">3 due this week</span>
              </div>
              <div class="ps-tile">
                <span class="ps-tile-label">Tasks done</span>
                <strong class="ps-tile-value">84%</strong>
                <span class="ps-tile-sub">This month</span>
              </div>
              <div class="ps-tile">
                <span class="ps-tile-label">Team</span>
                <strong class="ps-tile-value">6</strong>
                <span class="ps-tile-sub">Members online</span>
              </div>
              <div class="ps-tile ps-tile-wide">
                <span class="ps-tile-label">Latest update</span>
                <strong class="ps-tile-value">Deploy successful</strong>
                <span class="ps-tile-sub">2h ago</span>
              </div>
            </div>

            <span class="ps-section">Quick actions</span>
            <div class="ps-actions">
              <div class="ps-action ps-action-primary">
                <span class="ps-action-ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                    <path d="M16 2v4M8 2v4M3 10h18M12 14v4M10 16h4"></path>
                  </svg>
                </span>
                New project
              </div>
              <div class="ps-action">
                <span class="ps-action-ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <path d="M14 2v6h6M8 13h8M8 17h6"></path>
                  </svg>
                </span>
                View reports
              </div>
            </div>

            <div class="ps-nav">
              <span class="ps-nav-item active"></span>
              <span class="ps-nav-item"></span>
              <span class="ps-nav-item"></span>
              <span class="ps-nav-item"></span>
            </div>
          </div>
        </Iphone>
      </div>
    </div>
  </div>
</section>